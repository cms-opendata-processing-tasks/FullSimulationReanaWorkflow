BASE_CONTAINER="docker://gitlab-registry.cern.ch/cms-cloud/cmssw-docker/cc7-cms"
OPENDATA_CONTAINER="docker://cernopendata/cernopendata-client:latest"

RECORD_ID=config.get("record_id", 0)
totalEvents=config.get("events", 0)
eventsPerJob= 1
EOS_PATH=config.get("eos_outdir", "not found")


jobIndex = list(range(1, int(totalEvents/eventsPerJob)+1))

cleanup_command = """
    set -e    

    rm {EOS_PATH}/results/{params.step}_{wildcards.jobIndex}.root
    
    mkdir -p results/cleanup
    echo "Cleanup done" > results/cleanup/{params.step}_cleanup_{wildcards.jobIndex}_confirm.txt
"""


rule all:
    input:
        "results/nano_merged.root"

rule fetch_metadata:
    output:
        metadata=temporary("record_metadata.json")
    container:
        OPENDATA_CONTAINER
    shell:
        """
        cernopendata-client get-metadata --recid {RECORD_ID} > {output.metadata}
        """

rule parse_gen_metadata:
    input:
        metadata="record_metadata.json"
    output:
        temporary("gen_env.txt"),
        cmd_file=temporary("cmsDriver_gen.txt")
    params:
        step="gen"
    container:
        OPENDATA_CONTAINER
    shell:
        """
        set -e
        python3 workflow/scripts/parse_metadata.py {input.metadata} {output.cmd_file} {params.step}
        """

rule gen:
    input:
        cmd_file="cmsDriver_gen.txt",
        environment="gen_env.txt"
    output:
        temporary("results/gen_{jobIndex}_confirm.txt")
    params:
        events=eventsPerJob,
        step="gen"
    container:
        BASE_CONTAINER
    shell:
        """
        set -e
        export WORKDIR=$(pwd)

        JOB_DIR=$(mktemp -d)
        cd $JOB_DIR

        echo "Sourcing CMS environment"
        eval "$(cat $WORKDIR/{input.environment})"

        echo "Checking WORKDIR"
        ls -lh $WORKDIR/

        mkdir -p Configuration/GenProduction/python/
        cp $WORKDIR/Configuration/GenProduction/python/*.py Configuration/GenProduction/python/

        echo "Reached scramming"
        scram b 

        eval `scramv1 runtime -sh`

        mkdir -p $WORKDIR/results

        export EVENTS={params.events}
        export JOB_INDEX={wildcards.jobIndex}

        echo "Running cmsDriver"
        ls -lh Configuration/GenProduction/python/
        
        eval "$(cat $WORKDIR/{input.cmd_file})"
        
        echo "Directory after cmsDriver:"
        ls -lh

        echo "Running {params.step} cmsRun"

        cmsRun {params.step}_cfg_{wildcards.jobIndex}.py > cmsRun.log 2>&1 || true

        echo "Listing directories, to better understand what it looks like:"
        ls -lh 

        if ! ls *.root 1> /dev/null 2>&1; then
            echo "[ERROR] cmsRun exited, but no .root file was created"
            echo "[ERROR] Dumping the cmsRun log to see the exact CMS physics error:"
            cat cmsRun.log
            exit 1
        fi

        cp cmsRun.log $WORKDIR/{params.step}_{wildcards.jobIndex}.log
        
        mkdir -p {EOS_PATH}/results && cp {params.step}_output.root {EOS_PATH}/results/{params.step}_{wildcards.jobIndex}.root

        sync
        sleep 5

        rm -rf $JOB_DIR

        echo "{params.step} step done" > $WORKDIR/results/{params.step}_{wildcards.jobIndex}_confirm.txt    
        """

rule parse_sim_metadata:
    input:
        metadata="record_metadata.json"
    output:
        temporary("pileup_record_id.txt"),
        temporary("sim_env.txt"),
        cmd_file=temporary("cmsDriver_sim.txt")
    params:
        step="sim"
    container:
        OPENDATA_CONTAINER
    shell:
        """
        set -e
        python3 workflow/scripts/parse_metadata.py {input.metadata} {output.cmd_file} {params.step}
        """

rule sim:
    input:
        "results/gen_{jobIndex}_confirm.txt",
        cmd_file="cmsDriver_sim.txt",
        environment="sim_env.txt"
    output:
        temporary("results/sim_{jobIndex}_confirm.txt")
    container:
        BASE_CONTAINER
    params:
        events=eventsPerJob,
        step="sim",
        prev_step="gen"
    shell:
        """
        set -e
        export WORKDIR=$(pwd)

        JOB_DIR=$(mktemp -d)
        cd $JOB_DIR

        echo "Sourcing CMS environment"
        eval "$(cat $WORKDIR/{input.environment})"

        scram b
        eval `scramv1 runtime -sh`

        echo "Running {params.step} workflow"

        export JOB_INDEX={wildcards.jobIndex}
        export EVENTS={params.events} 
        export INPUT_FILE={EOS_PATH}/results/{params.prev_step}_{wildcards.jobIndex}.root
        
        echo "Running cmsDriver for SIM"
        eval "$(cat $WORKDIR/{input.cmd_file})"

        echo "Running cmsRun"
        cmsRun {params.step}_cfg_{wildcards.jobIndex}.py > cmsRun.log 2>&1 || true

        echo "Listing directories, to better understand what it looks like:"
        ls -lh 

        if ! ls *.root 1> /dev/null 2>&1; then
            echo "[ERROR] cmsRun exited, but no .root file was created"
            echo "[ERROR] Dumping the cmsRun log to see the exact CMS physics error:"
            cat cmsRun.log
            exit 1
        fi

        cp cmsRun.log $WORKDIR/{params.step}_{wildcards.jobIndex}.log

        cp {params.step}_output.root {EOS_PATH}/results/{params.step}_{wildcards.jobIndex}.root

        sync
        sleep 5

        echo "{params.step} step done" > $WORKDIR/results/{params.step}_{wildcards.jobIndex}_confirm.txt
        rm -rf $JOB_DIR
        """

rule gen_cleanup:
    input:
        "results/sim_{jobIndex}_confirm.txt"
    output:
        "results/cleanup/gen_cleanup_{jobIndex}_confirm.txt"
    params:
        step="gen"
    container:
        BASE_CONTAINER
    shell:
        cleanup_command

rule predigi2raw:
    input:
        record_id='pileup_record_id.txt'
    output:
        temporary("results/pileup_file.txt")
    container:
        OPENDATA_CONTAINER
    shell:
        """
            pileup_recid="$(cat {input.record_id})"
            mkdir -p results
            cernopendata-client get-file-locations --recid $pileup_recid --protocol xrootd > {output}
        """

rule parse_digi2raw_metadata:
    input:
        metadata="record_metadata.json"
    output:
        temporary("digi2raw_env.txt"),
        cmd_file=temporary("cmsDriver_digi2raw.txt")
    params:
        step="digi2raw"
    container:
        OPENDATA_CONTAINER
    shell:
        """
