rule merge_nano:
    input:
        expand("results/cleanup/pat_cleanup_{jobIndex}_confirm.txt", jobIndex=jobIndex),
        expand("results/nano_{jobIndex}_confirm.txt", jobIndex=jobIndex)
    output:
        merged_local=temporary("results/nano_merged.root")
    params:
        eos_inputs=" ".join([f"{EOS_PATH}/results/nano_{i}.root" for i in jobIndex]),
        eos_output=f"{EOS_PATH}/results/nano_merged.root"
    container:
        BASE_CONTAINER
    shell:
        """
        set -e
        export WORKDIR=$(pwd)

        echo "Sourcing CMS environment to get ROOT..."
        export SCRAM_ARCH=slc7_amd64_gcc700
        source /cvmfs/cms.cern.ch/cmsset_default.sh
        
        scram p CMSSW CMSSW_10_6_30
        cd CMSSW_10_6_30/src/
        eval `scramv1 runtime -sh`
        cd ../../
        
        echo "Merging all NanoAOD files..."
        python $WORKDIR/workflow/scripts/haddnano.py {output.merged_local} {params.eos_inputs}

        cp {output.merged_local} {params.eos_output}
        """