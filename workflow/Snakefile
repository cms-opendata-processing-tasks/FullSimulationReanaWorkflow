    container:
        OPENDATA_CONTAINER
    shell:
        """
        python3 workflow/scripts/parse_metadata.py {input.metadata} {output.cmd_file} {params.step}
        """

rule digi2raw:
    input:
        "results/cleanup/gen_cleanup_{jobIndex}_confirm.txt",
        "results/sim_{jobIndex}_confirm.txt",
        pileup="results/pileup_file.txt",
        cmd_file="cmsDriver_digi2raw.txt",
        environment="digi2raw_env.txt"
    output:
        temporary("results/digi2raw_{jobIndex}_confirm.txt")
    container:
        BASE_CONTAINER
    params:
        events=eventsPerJob,
        step="digi2raw",
        prev_step="sim",
        pileup="results/pileup_file.txt"
    shell:
        MAIN_STEP_SHELL

