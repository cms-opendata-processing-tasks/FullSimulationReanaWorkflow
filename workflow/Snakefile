        """

rule digi2raw:
    input:
        "results/cleanup/gen_cleanup_{jobIndex}_confirm.txt",
        "results/sim_{jobIndex}_confirm.txt",
        pileup="results/pileup_file.txt",
        cmd_file="cmsDriver_digi2raw.txt",
        environment="digi2raw_env.txt"
    output:
        temporary("results/digi2raw_{jobIndex}_confirm.txt")
    container:
        BASE_CONTAINER
    params:
        events=eventsPerJob,
        step="digi2raw",
        prev_step="sim"
    shell:
        """
        set -e
        export WORKDIR=$(pwd)

        JOB_DIR=$(mktemp -d)
        cd $JOB_DIR

        echo "Sourcing CMS environment"
        eval "$(cat $WORKDIR/{input.environment})"

        scram b
        eval `scramv1 runtime -sh`

        PILEUP_URL=$(sed -n '{wildcards.jobIndex}p' $WORKDIR/{input.pileup})

        echo "Running {params.step} workflow"

        export JOB_INDEX={wildcards.jobIndex}
        export EVENTS={params.events} 
        export INPUT_FILE={EOS_PATH}/results/{params.prev_step}_{wildcards.jobIndex}.root
        
        echo "Running cmsDriver for {params.step}"
        eval "$(cat $WORKDIR/{input.cmd_file})"

        echo "Running cmsRun"
        cmsRun {params.step}_cfg_{wildcards.jobIndex}.py > cmsRun.log 2>&1 || true

        echo "Listing directories, to better understand what it looks like:"
        ls -lh 

        if ! ls *.root 1> /dev/null 2>&1; then
            echo "[ERROR] cmsRun exited, but no .root file was created"
            echo "[ERROR] Dumping the cmsRun log to see the exact CMS physics error:"
            cat cmsRun.log
            exit 1
        fi

        cp cmsRun.log $WORKDIR/{params.step}_{wildcards.jobIndex}.log

        cp {params.step}_output.root {EOS_PATH}/results/{params.step}_{wildcards.jobIndex}.root

        sync
        sleep 5

        echo "{params.step} step done" > $WORKDIR/results/{params.step}_{wildcards.jobIndex}_confirm.txt
        rm -rf $JOB_DIR
        """

